# Phishing URL Scanner — Configuration Contract
# Copy this file to `.env` (`cp .env.example .env`) and fill in your credentials.
# `.env` is gitignored; NEVER commit `.env` or real API keys to the repository.

# REQUIRED — VirusTotal v3 API key used to query URL threat intelligence reports.
# Where to get it: Create a free account at https://www.virustotal.com/gui/join-us,
# then copy your 64-character personal API key from Profile -> API Key.
# Safe local / offline CI value: YourVirusTotalAPIKeyHere (returns deterministic offline Safe mock).
# Failure mode if missing/blank: Startup/scan fails loudly with missing VIRUSTOTAL_API_KEY.
VIRUSTOTAL_API_KEY=YourVirusTotalAPIKeyHere

# OPTIONAL — TCP port on which the Uvicorn FastAPI server listens.
# Where to get it: Set to any open local port or accept the platform-injected PORT in production.
# Safe local value: 8000 (binds to http://127.0.0.1:8000; use 8001 if 8000 is in use).
PORT=8000

# OPTIONAL — Allowed CORS origin URL for browser requests when frontend and API are split across hosts.
# Where to get it: Use the local server origin during development or your deployed static frontend URL.
# Safe local value: http://localhost:8000
FRONTEND_URL=http://localhost:8000

# OPTIONAL — Target base URL used by `./script/smoke` during smoke verification.
# Where to get it: Override only when smoke-testing a non-default port or staging URL.
# Safe local value: http://127.0.0.1:8000
APP_BASE_URL=http://127.0.0.1:8000

# OPTIONAL — Expected verdict string checked by `./script/smoke` against `POST /scan`.
# Where to get it: Matches the deterministic verdict returned for the smoke-test URL.
# Safe local value: Safe
SMOKE_EXPECT=Safe
